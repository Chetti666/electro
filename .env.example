# PostgreSQL
DATABASE_URL="postgresql://user:password@host:5432/database"
# Prisma Accelerate URL. Present in some deployments but not read by app code.
PRISMA_DATABASE_URL="prisma://..."

# Flow payments (use FLOW_ENV="production" only with live credentials)
FLOW_API_KEY=""
FLOW_SECRET_KEY=""
FLOW_ENV="sandbox"

# Public HTTPS URL used to build Flow confirmation/return callbacks.
# Local: use a tunnel URL (e.g. https://xxxx.trycloudflare.com), not localhost.
# Production: https://vmelectric.cl (or your deployed domain).
NEXT_PUBLIC_SITE_URL="https://your-tunnel.trycloudflare.com"

# Contact form (Gmail)
SMTP_USER=""
SMTP_PASS=""
CONTACT_EMAIL=""

# Saved report JSON limit (MB)
MAX_REPORT_DATA_MB="8"

# Google Drive integration in the SEV report
GOOGLE_API_KEY=""
